generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  googleSub String    @unique
  createdAt DateTime  @default(now())
  sessions  Session[]
  membership Membership?
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id String @id @default(uuid())
  slug String @unique
  name String
  isSample Boolean @default(false)
  memberships Membership[]
  policies BenefitPolicy[]
}

enum MembershipRole {
  EMPLOYEE
  REVIEWER
}

model Membership {
  userId String @id
  companyId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  claims Claim[]
  role MembershipRole @default(EMPLOYEE)

  @@unique([userId, companyId])
  @@index([companyId])
}

model BenefitPolicy {
  id String @id @default(uuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  month String
  allowance Int
  categories String[]
  guidance String

  @@unique([companyId, month])
}

enum ClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

model Claim {
  id String @id @default(uuid())
  requestId String?
  companyId String
  userId String
  membership Membership @relation(fields: [userId, companyId], references: [userId, companyId], onDelete: Cascade, onUpdate: Restrict)
  title String
  category String
  amount Int
  status ClaimStatus
  usedOn String
  submittedAt DateTime @default(now())
  rejectionReason String?
  reviewedBy String?
  reviewedAt DateTime?
  attachmentId String? @unique
  attachment Attachment? @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([userId, companyId, usedOn, submittedAt, id])
  @@index([companyId, usedOn, submittedAt, id])
  @@unique([userId, requestId])
}


enum AttachmentState {
  PENDING
  READY
  LINKED
  DELETING
}

model Attachment {
  id String @id
  userId String
  companyId String
  storageLocation String @default("local")
  mimeType String
  byteSize Int
  state AttachmentState @default(PENDING)
  createdAt DateTime @default(now())
  claim Claim?

  @@index([state, createdAt])
  @@index([userId, companyId])
}
