{
  "name": "chagok",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev:mobile": "npm run dev -w @chagok/mobile",
    "dev:preview": "npm run web -w @chagok/mobile",
    "dev:web": "npm run dev -w @chagok/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build:web": "npm run build -w @chagok/web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
