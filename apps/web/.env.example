# Server only. Never copy DATABASE_URL to EXPO_PUBLIC_* or commit real values.
DATABASE_URL=
# OAuth client of type Web, also supplied to the native Google SDK as webClientId.
GOOGLE_WEB_CLIENT_ID=

# Development-only, absolute path OUTSIDE any public/static served directory.
# Production requires a private object-storage adapter; local storage fails closed.
RECEIPT_LOCAL_DIR=

# Server only. Use supabase to write to the project's private receipts bucket.
# Run cleanup with the same provider and project as the files being cleaned.
RECEIPT_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
