# iOS simulator: 127.0.0.1; Android emulator: 10.0.2.2; physical device: Mac LAN IP
EXPO_PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
# 실제 측정 전에 실행 환경과 대조해 입력합니다. 비밀값을 넣지 마세요.
# EXPO_PUBLIC_BENCHMARK_DEVICE=iPhone model (iOS Simulator, arm64)
# EXPO_PUBLIC_BENCHMARK_APP_BUILD=development 0.1.0 (1), Debug simulator
# EXPO_PUBLIC_BENCHMARK_WEB_MODE=development
# EXPO_PUBLIC_BENCHMARK_SOURCE_REF=sha256:<source manifest digest>

# 로컬 M09 화면 검증 버튼. __DEV__에서만 1로 활성화, 평소에는 0.
EXPO_PUBLIC_VISUAL_CHECKS=0
